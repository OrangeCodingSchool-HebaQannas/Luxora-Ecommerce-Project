<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — LUXORA Admin</title>

    <!-- Bootstrap 5 CSS (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- Your custom admin CSS -->
    <link rel="stylesheet" href="~/css/admin-theme.css" />
</head>
<body>

    <nav id="sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon">LX</div>
            <div>
                <div class="brand-name">LUXORA</div>
                <div class="brand-sub">Admin Panel</div>
            </div>
        </div>

        <div class="sidebar-nav">
            <div class="nav-group-label">Overview</div>
            <a asp-area="Admin" asp-controller="Admin" asp-action="Index"
               class="nav-link-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" ? "active" : "")">
                <i class="bi bi-grid-1x2-fill"></i> Dashboard
            </a>

            <div class="nav-group-label">Catalogue</div>
            <a asp-area="admin" asp-controller="Products" asp-action="Index"
               class="nav-link-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Products" ? "active" : "")">
                <i class="bi bi-box-seam-fill"></i> Products
            </a>
            <a asp-area="admin" asp-controller="Categories" asp-action="Index"
               class="nav-link-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Categories" ? "active" : "")">
                <i class="bi bi-tags-fill"></i> Categories
            </a>

            <div class="nav-group-label">Commerce</div>
            <a asp-area="admin" asp-controller="Orders" asp-action="Index"
               class="nav-link-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Orders" ? "active" : "")">
                <i class="bi bi-receipt-cutoff"></i> Orders
            </a>
            <a asp-area="admin" asp-controller="Users" asp-action="Index"
               class="nav-link-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Users" ? "active" : "")">
                <i class="bi bi-people-fill"></i> Users
            </a>

            <div class="nav-group-label">Moderation</div>
            <a asp-area="admin" asp-controller="Testimonials" asp-action="Index"
               class="nav-link-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Testimonials" ? "active" : "")">
                <i class="bi bi-chat-quote-fill"></i> Testimonials
            </a>
            <a asp-area="admin" asp-controller="ProductComments" asp-action="Index"
               class="nav-link-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ProductComments" ? "active" : "")">
                <i class="bi bi-star-half"></i> Reviews
            </a>
            <div class="nav-group-label">Marketing</div>
            <a asp-area="Admin" asp-controller="Discounts" asp-action="Index"
               class="nav-link-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Discounts" ? "active" : "")">
                <i class="bi bi-percent"></i> Discounts & Offers
            </a>
        </div>

        <div class="sidebar-footer">
            <div class="s-avatar">SA</div>
            <div>
                <div class="s-name">Super Admin</div>
                <div class="s-role">Administrator</div>
            </div>
            <button class="s-logout" onclick="toast('Logged out','danger')" title="Logout">
                <i class="bi bi-box-arrow-right"></i>
            </button>
        </div>
    </nav>

    <!-- MAIN CONTENT WRAPPER -->
    <div id="main-content">

        <div class="topbar">
            <button class="sidebar-toggle" onclick="document.getElementById('sidebar').classList.toggle('open')">
                <i class="bi bi-list"></i>
            </button>
            <div>
                <div class="topbar-title" id="topbar-title">@ViewData["Title"]</div>
                <div class="topbar-crumb" id="topbar-crumb">Admin / @ViewData["Title"]</div>
            </div>
            <div class="topbar-search">
                <i class="bi bi-search" style="color:var(--gold)"></i>
                <input type="text"
                       placeholder="Search the vault)"
                       id="global-vault-search"
                       oninput="vaultSearch(this.value)" />
            </div>
        </div>

        <main role="main" class="page-section active">
            @RenderBody()
        </main>

    </div>```


    <!-- ═══ MODAL: ADD / EDIT CATEGORY ═══ -->
    <div class="modal-overlay" id="modal-category">
        <div class="modal-box">
            <div class="modal-hdr">
                <div class="modal-hdr-title"><i class="bi bi-tags-fill"></i>Add / Edit Category</div>
                <button class="modal-close" onclick="closeModal('modal-category')"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label">Category Name *</label><input class="form-control" id="cat-name-input" placeholder="e.g. Luxury Watches" oninput="genSlug(this)" /></div>
                <div class="mb-3"><label class="form-label">Slug <small style="font-weight:400;color:var(--muted)">(auto-generated)</small></label><input class="form-control" id="cat-slug-input" placeholder="luxury-watches" /></div>
                <div class="mb-3"><label class="form-label">Description</label><textarea class="form-control" rows="3" placeholder="Optional description…"></textarea></div>
                <div class="mb-3">
                    <label class="form-label">Parent Category</label>
                    <select class="form-select"><option value="">None (Top Level)</option><option>Watches</option><option>Luxury Bags</option><option>Accessories</option></select>
                </div>
            </div>
            <div class="modal-ftr">
                <button class="btn-lx-outline" onclick="closeModal('modal-category')"><i class="bi bi-x-lg"></i>Cancel</button>
                <button class="btn-lx-primary" onclick="closeModal('modal-category');toast('Category saved','success')"><i class="bi bi-check-lg"></i>Save Category</button>
            </div>
        </div>
    </div>

    <!-- ═══ MODAL: ORDER DETAIL ═══ -->
    <div class="modal-overlay" id="modal-order">
        <div class="modal-box wide">
            <div class="modal-hdr">
                <div class="modal-hdr-title"><i class="bi bi-receipt-cutoff"></i>Order Detail — #ORD-1042</div>
                <button class="modal-close" onclick="closeModal('modal-order')"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body">
                <div class="order-steps">
                    <div class="step done"><div class="step-dot"><i class="bi bi-check-lg"></i></div><div class="step-lbl">Placed</div></div>
                    <div class="step done"><div class="step-dot"><i class="bi bi-check-lg"></i></div><div class="step-lbl">Confirmed</div></div>
                    <div class="step current"><div class="step-dot"><i class="bi bi-hourglass-split"></i></div><div class="step-lbl">Processing</div></div>
                    <div class="step"><div class="step-dot"><i class="bi bi-truck"></i></div><div class="step-lbl">Shipped</div></div>
                    <div class="step"><div class="step-dot"><i class="bi bi-house-door-fill"></i></div><div class="step-lbl">Delivered</div></div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div style="background:#f7faf8;border-radius:10px;padding:16px;border:1px solid var(--border)">
                            <div style="font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:10px"><i class="bi bi-person-fill me-1"></i>Customer</div>
                            <div style="font-size:13.5px"><strong>James Vance</strong></div>
                            <div style="font-size:12px;color:var(--muted)">james@email.com</div>
                            <div style="font-size:12px;color:var(--muted);margin-top:4px"><i class="bi bi-geo-alt-fill me-1"></i>123 Mayfair St, London, UK</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div style="background:#f7faf8;border-radius:10px;padding:16px;border:1px solid var(--border)">
                            <div style="font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:10px"><i class="bi bi-info-circle-fill me-1"></i>Order Info</div>
                            <div style="font-size:12px;margin-bottom:4px"><strong>Order ID:</strong> #ORD-1042</div>
                            <div style="font-size:12px;margin-bottom:4px"><strong>Date:</strong> May 10, 2025</div>
                            <div style="font-size:12px;margin-bottom:4px"><strong>Payment:</strong> <span class="lx-badge b-success" style="font-size:10px"><i class="bi bi-check-circle-fill"></i>Paid</span></div>
                            <div style="font-size:12px"><strong>Total:</strong> <span style="color:var(--success);font-weight:800">$13,200</span></div>
                        </div>
                    </div>
                </div>
                <div style="border-radius:10px;overflow:hidden;border:1px solid var(--border)">
                    <table class="lx-table">
                        <thead><tr><th>Product</th><th>Qty</th><th>Unit Price</th><th>Subtotal</th></tr></thead>
                        <tbody>
                            <tr><td><div class="td-product"><div class="td-thumb">⌚</div><div><div class="td-name">Rolex Datejust 41</div><div class="td-sub">Green Dial · Oystersteel</div></div></div></td><td>1</td><td>$13,200</td><td><strong>$13,200</strong></td></tr>
                        </tbody>
                    </table>
                </div>
                <div style="margin-top:16px;padding:14px;background:#f7faf8;border-radius:10px;border:1px solid var(--border)">
                    <div style="font-size:12px;font-weight:700;margin-bottom:10px"><i class="bi bi-pencil-square me-1" style="color:var(--gold)"></i>Update Order Status</div>
                    <div style="display:flex;gap:10px;align-items:center">
                        <select class="form-select form-select-sm" style="width:160px" id="order-status-sel">
                            <option>Processing</option>
                            <option>Completed</option>
                            <option>Cancelled</option>
                        </select>
                        <button class="btn-lx-primary" onclick="updateStatus(document.getElementById('order-status-sel'));closeModal('modal-order')">
                            <i class="bi bi-check-lg"></i>Save Status
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-ftr">
                <button class="btn-lx-outline" onclick="closeModal('modal-order')"><i class="bi bi-x-lg"></i>Close</button>
                <button class="btn-lx-outline" onclick="toast('Invoice PDF generated','info')"><i class="bi bi-file-earmark-pdf-fill" style="color:var(--danger)"></i>Download Invoice</button>
            </div>
        </div>
    </div>

    <!-- ═══ MODAL: CONFIRM DELETE ═══ -->
    <div class="modal-overlay" id="modal-delete">
        <div class="modal-box" style="width:400px;max-width:95vw">
            <div class="modal-hdr" style="border:none">
                <div class="modal-hdr-title" style="color:var(--danger)"><i class="bi bi-exclamation-triangle-fill" style="color:var(--danger)"></i>Confirm Deletion</div>
                <button class="modal-close" onclick="closeModal('modal-delete')"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body" style="text-align:center;padding-top:0">
                <div style="width:64px;height:64px;background:#fdecea;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;font-size:28px;color:var(--danger)">
                    <i class="bi bi-trash3-fill"></i>
                </div>
                <p style="font-size:14px;color:var(--muted)">Are you sure you want to delete this <strong id="delete-type">item</strong>?<br>This action <strong>cannot be undone</strong>.</p>
            </div>
            <div class="modal-ftr" style="justify-content:center">
                <button class="btn-lx-outline" onclick="closeModal('modal-delete')"><i class="bi bi-x-lg"></i>Cancel</button>
                <button class="btn-lx-danger" style="padding:8px 20px;font-size:13px;font-weight:700" onclick="closeModal('modal-delete');toast('Item deleted','danger')">
                    <i class="bi bi-trash3-fill"></i>Yes, Delete
                </button>
            </div>
        </div>
    </div>

    <!-- Toast container -->
    <div id="toast-container"></div>




    <!-- Bootstrap 5 JS (CDN) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Your custom admin JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/admin.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Use Html.Raw to prevent encoding issues
            var message = '@Html.Raw(TempData["Notification"])';
            var type = '@TempData["NotificationType"]';

            if (message && message.trim() !== "") {
                // Check if notify exists (it should be in site.js or admin.js)
                if (typeof notify === "function") {
                    notify(type || 'success', 'LUXORA System', message);
                } else {
                    // Fallback directly to Swal if notify helper isn't loaded yet
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: type || 'success',
                        title: message,
                        showConfirmButton: false,
                        timer: 3000,
                        background: '#004225',
                        color: '#fff'
                    });
                }
            }
        });
    </script>


    <!-- Per-page scripts section (optional) -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>


